{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndicadoresBemViver",
  "description": "Schema de validação para os indicadores de Bem Viver e além do PIB no ecossistema YBY VersuS",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nome",
      "bloco",
      "descricaoCurta",
      "oQueNaoMede",
      "unidade",
      "periodicidade",
      "serie",
      "anoMaisRecente",
      "fonteNome",
      "fonteUrl",
      "licenca",
      "dataDeColeta"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "nome": {
        "type": "string",
        "minLength": 3
      },
      "bloco": {
        "type": "string",
        "enum": ["economia", "distribuicao", "pessoas", "ambiente", "percepcao"]
      },
      "descricaoCurta": {
        "type": "string",
        "minLength": 10
      },
      "oQueNaoMede": {
        "type": "string",
        "minLength": 10
      },
      "unidade": {
        "type": "string",
        "minLength": 1
      },
      "periodicidade": {
        "type": "string"
      },
      "serie": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["ano", "valor"],
          "properties": {
            "ano": {
              "type": "integer"
            },
            "valor": {
              "type": ["number", "null"]
            }
          }
        }
      },
      "anoMaisRecente": {
        "type": "integer"
      },
      "fonteNome": {
        "type": "string",
        "minLength": 2
      },
      "fonteUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "licenca": {
        "type": "string"
      },
      "dataDeColeta": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "observacoes": {
        "type": "string"
      }
    }
  }
}

